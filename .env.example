# ============================================================================
# Configuración del entorno - Proyecto SAReduccion (Plantilla de Ejemplo)
# ============================================================================

# --- Oracle Database ---
ORACLE_PASSWORD=                        # Contraseña del usuario SYS / SYSTEM
ORACLE_APP_USER=SA_REDUCCION            # Propietario del esquema; solo inicialización/migraciones
ORACLE_APP_PASSWORD=                    # Contraseña del propietario del esquema
ORACLE_BACKEND_USER=SAR_BACKEND         # Cuenta técnica JDBC (solo CREATE SESSION y EXECUTE)
ORACLE_BACKEND_PASSWORD=                # Contraseña de la cuenta técnica JDBC
ORACLE_DATABASE=XEPDB1                  # Nombre del PDB en Oracle XE 21c
ORACLE_PORT=1522                        # Puerto expuesto al host

ORACLE_ALUMNO_USER=ALU_21281181         # Usuario Estudiante / Alumno
ORACLE_ALUMNO_PASSWORD=                 # Contraseña del estudiante / alumno
ORACLE_ADMIN_USER=SA01                  # Usuarios de servicios administrativos
ORACLE_ADMIN_PASSWORD=                  # Contraseña de servicios administrativos

# --- Datos de inicialización ---
# true  = la primera inicialización carga los datos ficticios de desarrollo
#         (9 estudiantes, 2 administradores, 8 aspirantes, solicitudes, etc.)
# false = se crea solo el esquema, sin datos de aplicación
SAR_LOAD_DEV_SEED=true                  # En producción debe valer false

# --- Spring Boot ---
APP_PORT=8080                           # Puerto de la API REST
SPRING_PROFILES_ACTIVE=dev              # Perfil activo

# --- Frontend ---
FRONTEND_PORT=8081                      # Puerto local del frontend Nginx