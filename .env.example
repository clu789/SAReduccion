# ============================================================================
# Configuración del entorno - Proyecto SAReduccion (Plantilla de Ejemplo)
# ============================================================================

# --- Oracle Database ---
ORACLE_PASSWORD=                        # Contraseña del usuario SYS / SYSTEM
ORACLE_APP_USER=SA_REDUCCION            # Usuario de la aplicación
ORACLE_APP_PASSWORD=                    # Contraseña del usuario de la aplicación
ORACLE_DATABASE=XEPDB1                  # Nombre del PDB en Oracle XE 21c
ORACLE_PORT=1522                        # Puerto expuesto al host

ORACLE_ALUMNO_USER=ALU_21281181         # Usuario Estudiante / Alumno
ORACLE_ALUMNO_PASSWORD=                 # Contraseña del estudiante / alumno
ORACLE_ADMIN_USER=SA01                  # Usuarios de servicios administrativos
ORACLE_ADMIN_PASSWORD=                  # Contraseña de servicios administrativos

# --- Spring Boot ---
APP_PORT=8080                           # Puerto de la API REST
SPRING_PROFILES_ACTIVE=dev              # Perfil activo