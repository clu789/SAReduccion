# ============================================================================
# Configuración del entorno - Proyecto SAReduccion
# ============================================================================

# --- Oracle Database ---
ORACLE_PASSWORD=SaReduccion2026!        # Contraseña del usuario SYS / SYSTEM
ORACLE_APP_USER=SA_REDUCCION            # Propietario del esquema; solo inicialización/migraciones
ORACLE_APP_PASSWORD=AppPass2026!        # Contraseña del propietario del esquema
ORACLE_BACKEND_USER=SAR_BACKEND         # Cuenta técnica JDBC (solo CREATE SESSION y EXECUTE)
ORACLE_BACKEND_PASSWORD=BackendPass2026! # Contraseña de la cuenta técnica JDBC
ORACLE_DATABASE=XEPDB1                  # Nombre del PDB en Oracle XE 21c
ORACLE_PORT=1522                        # Puerto expuesto al host

ORACLE_ALUMNO_USER=ALU_21281181         # Usuario Estudiante / Alumno
ORACLE_ALUMNO_PASSWORD=AluPass2026!     # Contraseña del estudiante / alumno
ORACLE_ADMIN_USER=SA01                  # Usuarios de servicios administrativos
ORACLE_ADMIN_PASSWORD=AdminPass2026!    # Contraseña de servicios administrativos

# --- Spring Boot ---
APP_PORT=8080                           # Puerto de la API REST
SPRING_PROFILES_ACTIVE=dev              # Perfil activo
# --- Datos de inicializacion ---
# true = la primera inicializacion carga los datos ficticios de desarrollo.
SAR_LOAD_DEV_SEED=true

# --- Frontend ---
FRONTEND_PORT=8081                     # Puerto local del frontend Nginx
