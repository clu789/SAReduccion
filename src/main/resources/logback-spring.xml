<?xml version="1.0" encoding="UTF-8"?>
<!--
  Estandar comun de logs tecnicos de SAReduccion (Equipo 1).

  Formato (una linea por evento, pares clave=valor):
    2026-11-15T10:15:30.123-06:00 level=INFO  corr=<id> ip=<cliente> thread=<hilo> logger=<clase> msg="<mensaje>"

  - corr: identificador de correlacion de la peticion (cabecera X-Correlation-ID).
  - %mmsg: mensaje con datos sensibles enmascarados (contrasenas, tokens, CURP, correos).
  - Consola: la recoge Docker (docker compose logs backend).
  - Archivo: rotacion diaria y por tamano (10 MB), 30 dias de retencion, 500 MB en total.
-->
<configuration scan="false">

  <conversionRule conversionWord="mmsg"
                  converterClass="com.itt.sareduccion.security.logging.MaskingMessageConverter"/>

  <springProperty scope="context" name="LOG_DIR" source="sar.logging.dir" defaultValue="logs"/>

  <property name="SAR_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level corr=%X{correlationId:--} ip=%X{clientIp:--} thread=%thread logger=%logger{40} msg=&quot;%mmsg&quot;%n%ex"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${SAR_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/sareduccion.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/sareduccion.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${SAR_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Niveles: ERROR fallo que requiere atencion; WARN anomalia recuperable o
       evento de seguridad rechazado; INFO hitos de negocio y de sesion;
       DEBUG diagnostico, solo en el perfil dev. -->
  <springProfile name="dev">
    <logger name="com.itt.sareduccion" level="DEBUG"/>
  </springProfile>
  <springProfile name="!dev">
    <logger name="com.itt.sareduccion" level="INFO"/>
  </springProfile>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
