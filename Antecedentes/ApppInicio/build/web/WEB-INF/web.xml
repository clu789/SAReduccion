<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <filter>
        <filter-name>AccessFilter</filter-name>
        <filter-class>filters.access.AccessFilter</filter-class>
    </filter>
    <filter>
        <filter-name>SessionFilter</filter-name>
        <filter-class>filters.session.SessionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AccessFilter</filter-name>
        <url-pattern>/inelegible.do</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>SessionFilter</filter-name>
        <url-pattern>/app/*</url-pattern>
    </filter-mapping>
    <servlet>
        <servlet-name>Error_Inelegible_Srv</servlet-name>
        <servlet-class>servlets.acceso.Error_Inelegible_Srv</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>MantenerSesion_Srv</servlet-name>
        <servlet-class>servlets.acceso.MantenerSesion_Srv</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogOut_Srv</servlet-name>
        <servlet-class>servlets.acceso.LogOut_Srv</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Home_Srv</servlet-name>
        <servlet-class>servlets.acceso.Home_Srv</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>Error_Inelegible_Srv</servlet-name>
        <url-pattern>/inelegible.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>MantenerSesion_Srv</servlet-name>
        <url-pattern>/app/sesion/keepAlive.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogOut_Srv</servlet-name>
        <url-pattern>/app/sesion/logOut</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Home_Srv</servlet-name>
        <url-pattern>/app/modulo/Home.do</url-pattern>
    </servlet-mapping>
    
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>
           inelegible.do
        </welcome-file>
    </welcome-file-list>
    <security-constraint>
        <display-name>Restrict Views</display-name>
        <web-resource-collection>
            <web-resource-name>views</web-resource-name>
            <description>Vistas de la Página</description>
            <url-pattern>*.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>
</web-app>
