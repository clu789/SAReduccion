# ============================================================
# .gitignore
# SAReducción – Instituto Tecnológico de Toluca
# ============================================================

# ── Credenciales y configuración local ──────────────────────
# .env nunca debe versionarse; la plantilla es .env.example
.env
.env.*
!.env.example
env
*.env.local

# ── Maven ───────────────────────────────────────────────────
target/
*.class
*.jar
*.war

# ── IDE ─────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.eclipse/
*.project
*.classpath
*.settings/
nbproject/
.continue/

# ── Docker ──────────────────────────────────────────────────
# No ignorar docker-compose.yml (es parte del proyecto)
# Sí ignorar overrides locales
docker-compose.override.yml

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ────────────────────────────────────────────────────
*.log
logs/

# ── Oracle backups (local only) ─────────────────────────────
# Los respaldos viven solo en el equipo anfitrión.
backups/
# Artefactos de Oracle Data Pump (nunca versionar)
*.dmp
*.exp.log
*.imp.log
expdp*.log
impdp*.log
